{
  "name": "dsh-bs-better-git-viewer",
  "version": "0.2.0",
  "description": "DSH web plugin (dsh-better-sidebar consumer): a read-only multi-repo Git browser — discovers every git repository under the session workspace (with an exclude list), switchable from a dropdown, with status / inline diff / history preview. Writes are left to the agent.",
  "type": "module",
  "main": "out/index.js",
  "exports": {
    ".": {
      "default": "./out/index.js"
    },
    "./client": {
      "default": "./out/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install:plugin": "node scripts/install.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "dsh-better-sidebar": "^0.12.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "ws": "^8.21.3",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "dsh-better-sidebar": "^0.12.2",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
